# Copy to .env and fill in. Nothing here ever reaches the browser.
OPENAI_API_KEY=sk-...

# Leave unset for live mode. MOCK=1 runs the whole pipeline with synthetic
# images and zero API spend - useful for clicking through the UI first.
# MOCK=1

REASONING_MODEL=gpt-6-astra
DRAFT_MODEL=gpt-image-2.5-flare
FINAL_MODEL=gpt-image-2.5-sunburst
REASONING_EFFORT=medium
DRAFT_QUALITY=medium
FINAL_QUALITY=high

# QA tolerances
DELTA_E_PASS=2.0
DELTA_E_WARN=5.0
SSIM_PASS=0.97

# CAD rendering
RENDER_SIZE=1024
MAX_FACES=80000

# Flip if your gateway inverts mask polarity (white = replace)
MASK_TRANSPARENT_IS_EDITABLE=true

# --- Deployment only --------------------------------------------------------
# Leave these unset locally. On a public server all three are required.
# PORTAL_PASSWORD=                 # login gate; unset means no gate at all
# SESSION_SECRET=                  # openssl rand -hex 32
# HTTPS=1                          # marks the session cookie secure

# Hard daily ceiling in USD, reset at 00:00 UTC. 0 disables it.
DAILY_CAP=25

# ESTIMATES used to enforce the cap - not billed amounts. Check your OpenAI
# dashboard after a few real runs and correct them.
COST_PER_IMAGE=0.19
COST_PER_TEXT_CALL=0.04

WORKERS=2
